    },
    "excerpt": {
      "type": "text"
    },
    "author": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "readTime": {
      "type": "string"
    },
    "views": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "tags": {
      "type": "string"
    },
    "categories": {
