{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "Subheading": {
      "type": "string"
    },
    "Slug": {
      "type": "uid",
      "required": true
    },
    "Categories": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "options": [
        "Blogs",
        "DOOH Advertising",
        "CTV Advertising",
        "Omnichannel Advertising",
        "Programmatic Advertising",
        "Full Funnel Advertising /Performance Marketing"
      ]
    },
    "Content": {
      "type": "blocks",
      "required": true
    },
    "DateTime": {
      "type": "datetime"
    },
    "Thumbnail": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Author": {
      "type": "enumeration",
      "enum": [
        " Lemma Editorial Team",
        "Lemma Team",
        "lemma neww"
      ]
    },
    "PinToTrending": {
      "type": "boolean",
      "default": false
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
