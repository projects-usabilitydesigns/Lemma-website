{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post "
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "text"
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "category": {
      "type": "string",
      "default": "Blogs"
    },
    "author": {
      "type": "string"
    },
    "authorRole": {
      "type": "string"
    },
    "accent": {
      "type": "string",
      "default": "#008fdb"
    },
    "date": {
      "type": "string"
    },
    "readTime": {
      "type": "string"
    },
    "views": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "tags": {
      "type": "string"
    },
    "body": {
      "type": "text"
    }
  }
}
